# Database configuration (PostgreSQL for Docker Compose)
DATABASE_URL=postgresql+asyncpg://postgres:postgres@db:5432/plant_disease_db
SYNC_DATABASE_URL=postgresql+psycopg2://postgres:postgres@db:5432/plant_disease_db

# Model configuration
MODEL_CHECKPOINT_PATH=ml/runs/resnet34_weighted_seed42/best_model.pt
MODEL_ARCH=resnet34
IMG_SIZE=224
DEVICE=cpu
TEMPERATURE=1.0

# Upload directory
UPLOAD_DIR=backend/uploads
